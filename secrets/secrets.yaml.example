# Rampart-NixOS Secrets Configuration - EXAMPLE
# This is a template file matching modules/includes/variables.nix.example
# Copy this to secrets.yaml, fill with your real values, and encrypt with SOPS:
#   cp secrets.yaml.example secrets.yaml
#   # Edit secrets.yaml with your values
#   nix-shell -p sops --run "sops -e -i secrets/secrets.yaml"
#
# Note: system, hostName, stateVersion are PUBLIC (in flake-public-vars.nix)

# ############################################################################
# DISK ENCRYPTION & BOOT
# ############################################################################
boot:
  # LUKS device UUIDs - find with: ls -l /dev/disk/by-uuid/
  luksSwapUUID: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  luksRootUUID: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
  bootPartitionUUID: "XXXX-XXXX"

  # Boot settings
  timeout: 5       # Bootloader timeout in seconds
  configLimit: 5   # Number of boot configurations to keep

# ############################################################################
# USER CONFIGURATION
# ############################################################################
user:
  mainUser: "user"
  mainUserDescription: "NixOS User"
  # Generate password hash with: mkpasswd -m sha-512
  mainUserHashedPassword: "$6$rounds=656000$..."  # Replace with your hash

# ############################################################################
# SECURITY CONFIGURATION
# ############################################################################
security:
  # Sudo configuration
  sudoPasswdTimeout: 25        # Password timeout in seconds
  sudoTimestampTimeout: 5      # Timestamp timeout in minutes
  sudoPasswdTries: 3           # Maximum authentication attempts
  sudoSecurePath: "/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin"
  sudoLogFile: "/var/log/sudo.log"
  sudoMaxSeq: 1000

  # Login security
  loginFailDelay: 5000000      # microseconds (5s)
  shadowHashRounds: 65536      # Password hashing rounds

# ############################################################################
# NIX CONFIGURATION
# IMPORTANT: sops-nix only supports scalar values (strings, ints, bools).
# Lists MUST be stored as newline-separated strings or JSON arrays in a string.
# The readSecretList helper in vars-compat.nix handles both formats.
# ############################################################################
nix:
  # Newline-separated list of experimental features
  experimentalFeatures: |
    nix-command
    flakes

  autoOptimiseStore: true      # Automatic deduplication

  # Newline-separated list of trusted users
  trustedUsers: |
    root
    @wheel

  # Newline-separated list of allowed users
  allowedUsers: "@wheel"

  # Package permissions
  allowUnfree: true            # Allow unfree packages
  permittedInsecurePackages: "" # Empty string = empty list. Add newline-separated packages here
  # Newline-separated list of allowed unfree packages
  allowUnfreeList: |
    discord
    vscode

  # Binary cache configuration (newline-separated)
  substituters: |
    https://cache.nixos.org
    https://nix-community.cachix.org

  # Newline-separated list of trusted public keys
  trustedPublicKeys: |
    cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY=
    nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs=

  # Garbage collection
  gcAutomatic: true
  gcDates: weekly
  gcOptions: --delete-older-than 30d

# ############################################################################
# LOCALIZATION
# ############################################################################
locale:
  timeZone: Europe/London
  defaultLocale: en_US.UTF-8
  consoleKeyMap: us
  keyboardLayout: us           # Comma-separated: "us,de,fr"

# ############################################################################
# USBGUARD CONFIGURATION
# ############################################################################
usbguard:
  # Generate rules: sudo usbguard generate-policy
  # List devices: usbguard list-devices
  # Empty string = empty list. Add newline-separated rules here.
  allowedDevices: ""
  # Example (newline-separated string):
  # allowedDevices: |
  #   allow id 1d6b:0002 serial "0000:00:14.0" name "xHCI Host Controller"
  #   allow id 046d:c52b name "Logitech Keyboard" with-interface 03:01:01
  #   allow with-interface 03:01:01
