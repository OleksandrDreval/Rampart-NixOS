{
  # ============================================================================
  # SYSTEM CONFIGURATION
  # ============================================================================
  
  # System architecture
  system = "x86_64-linux";  # or "aarch64-linux" for ARM
  
  # Machine hostName (used in flake.nix and networking)
  hostName = "nixos";
  
  # NixOS release version
  stateVersion = "25.11";  # Don't change unless you know what you're doing
  
  # ============================================================================
  # DISK ENCRYPTION
  # ============================================================================
  
  # LUKS device UUIDs
  # Find with: ls -l /dev/disk/by-uuid/
  luksSwapUUID = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx";
  luksRootUUID = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx";
  
  # Boot partition UUID
  bootPartitionUUID = "XXXX-XXXX";
  
  # ============================================================================
  # USER CONFIGURATION
  # ============================================================================
  
  # User configuration
  mainUser = "user";
  mainUserDescription = "NixOS User";
  # Generate password hash with: mkpasswd -m sha-512
  mainUserHashedPassword = "$6$rounds=656000$...";  # Replace with your hash
  
  # ============================================================================
  # BOOT CONFIGURATION
  # ============================================================================
  
  # Boot configuration
  bootTimeout = 5;      # Bootloader timeout in seconds
  bootConfigLimit = 5;  # Number of boot configurations to keep
  
  # ============================================================================
  # SECURITY CONFIGURATION
  # ============================================================================
  
  # Sudo configuration
  sudoPasswdTimeout = 25;    # Password timeout in seconds
  sudoTimestampTimeout = 5;  # Timestamp timeout in minutes
  sudoPasswdTries = 3;       # Maximum authentication attempts
  sudoSecurePath = "/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin";
  sudoLogFile = "/var/log/sudo.log";
  sudoMaxSeq = 1000;
  
  # Login security
  loginFailDelay = 5000000;  # microseconds (5s)
  shadowHashRounds = 65536;  # Password hashing rounds
  
  # ============================================================================
  # NIX CONFIGURATION
  # ============================================================================
  
  # Nix experimental features
  nixExperimentalFeatures = [ "nix-command" "flakes" ];
  
  # Nix settings
  nixAutoOptimiseStore = true;  # Automatic deduplication
  nixTrustedUsers = [ "root" "@wheel" ];
  nixAllowedUsers = [ "@wheel" ];
  
  # Package permissions
  allowUnfree = true;  # Allow unfree packages
  permittedInsecurePackages = [];  # Add insecure packages here
  allowUnfreeList = [ "discord" "vscode" ];  # Specific unfree packages
  
  # Binary cache configuration
  substituters = [
    "https://cache.nixos.org"
    "https://nix-community.cachix.org"
  ];
  
  trustedPublicKeys = [
    "cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY="
    "nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs="
  ];
  
  # Garbage collection
  gcAutomatic = true;
  gcDates = "weekly";
  gcOptions = "--delete-older-than 30d";
  
  # ============================================================================
  # LOCALIZATION
  # ============================================================================
  
  # Localization
  timeZone = "Europe/London";
  defaultLocale = "en_US.UTF-8";
  consoleKeyMap = "us";
  keyboardLayout = "us";  # Comma-separated: "us,de,fr"
  
  # ============================================================================
  # USBGUARD CONFIGURATION
  # ============================================================================
  
  # USBGuard allowed devices
  # Generate rules: sudo usbguard generate-policy
  # List devices: usbguard list-devices
  usbguardAllowedDevices = [
    # System USB controllers (required for USB to work)
    # Example:
    # "allow id 1d6b:0002 serial \"0000:00:14.0\" name \"xHCI Host Controller\""
    
    # Keyboard example:
    # "allow id 046d:c52b name \"Logitech Keyboard\" with-interface 03:01:01"
    
    # Mouse example:
    # "allow id 046d:c077 name \"Logitech Mouse\" with-interface 03:01:02"
    
    # Allow all keyboards (less secure):
    # "allow with-interface 03:01:01"
    
    # Allow all mice (less secure):
    # "allow with-interface 03:01:02"
  ];
}
