{
  # LUKS device UUIDs
  # Replace with your actual UUIDs from: ls -l /dev/disk/by-uuid/
  luksSwapUUID = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx";
  luksRootUUID = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx";
  
  # Boot partition UUID
  bootPartitionUUID = "XXXX-XXXX";
  
  # Network configuration
  hostname = "nixos";
  
  # User configuration
  mainUser = "user";
  mainUserDescription = "NixOS User";
  # Generate password hash with: mkpasswd -m sha-512
  # Or use initialHashedPassword if you want to set password later via passwd (requires mutableUsers = true)
  mainUserHashedPassword = "$6$rounds=656000$...";  # Replace with your actual password hash
  
  # Boot configuration
  bootTimeout = 5;      # Bootloader timeout in seconds
  bootConfigLimit = 5;  # Number of boot configurations to keep (recommended: 3-10)
  
  # Sudo configuration
  sudoPasswdTimeout = 25;    # Password timeout in seconds (time to enter password)
  sudoTimestampTimeout = 5;  # Timestamp timeout in minutes (sudo cache duration)
  # Login failure delay (microseconds) applied after a failed login attempt
  # Example default shown here is 5 seconds (5000000 μs)
  loginFailDelay = 5000000;  # microseconds (5s)
  # Shadow password hashing rounds for /etc/shadow (increase brute-force cost)
  # Example: 65536
  shadowHashRounds = 65536;
  
  # Localization
  # See available timezones: timedatectl list-timezones
  timeZone = "Europe/London";
  # See available locales: localectl list-locales
  defaultLocale = "en_US.UTF-8";
  # See available keymaps: localectl list-keymaps
  consoleKeyMap = "us";
  # X11 keyboard layouts (comma-separated, e.g., "us,de,fr")
  xkbLayout = "us";
  
  # USBGuard allowed devices
  # Add your trusted USB devices here
  # To generate rules for currently connected devices: sudo usbguard generate-policy
  # To list all connected devices: usbguard list-devices
  usbguardAllowedDevices = [
    # System USB controllers (required for USB to work)
    # These are auto-generated when you run: sudo usbguard generate-policy
    # Example:
    # "allow id 1d6b:0002 serial \"0000:00:14.0\" name \"xHCI Host Controller\""
    
    # Add your trusted devices below:
    # Keyboard example:
    # "allow id 046d:c52b name \"Logitech Keyboard\" with-interface 03:01:01"
    
    # Mouse example:
    # "allow id 046d:c077 name \"Logitech Mouse\" with-interface 03:01:02"
    
    # USB flash drive example (specific device):
    # "allow id 0781:5583 serial \"123456789ABC\" name \"SanDisk USB\" with-interface 08:06:50"
    
    # Webcam example:
    # "allow id 046d:0825 name \"Logitech Webcam\" with-interface { 0e:01:00 0e:02:00 }"
    
    # Allow all keyboards (less secure, but convenient):
    # "allow with-interface 03:01:01"
    
    # Allow all mice (less secure, but convenient):
    # "allow with-interface 03:01:02"
  ];
}
